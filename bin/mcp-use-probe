#!/usr/bin/env node
// Live protocol probe for MCP servers over Streamable HTTP: snapshots, diffs, and host checks.
import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
import { dirname } from "node:path";
import { connect } from "../lib/mcp-http.mjs";
import { connectStdio } from "../lib/mcp-stdio.mjs";
import { takeSnapshot, diffSnapshots, chatgptChecks, archestraChecks, authChallengeCheck } from "../lib/probe.mjs";
import { envelope, EXIT } from "../lib/envelope.mjs";
import { parseCli, usage, requireFile, requireDir } from "../lib/cli.mjs";

const TOOL = "mcp-use-probe";
const HOSTS = ["chatgpt", "archestra", "stack"];
const { values: o, positionals } = parseCli(TOOL, {
  url: { type: "string" }, stdio: { type: "string" }, cwd: { type: "string" }, host: { type: "string" }, ua: { type: "string" },
  token: { type: "string" }, calls: { type: "string" }, timeout: { type: "string" }, snapshot: { type: "string" },
  submit: { type: "boolean" }, json: { type: "boolean" }, diff: { type: "boolean" },
}, { positionals: true });
const json = !!o.json;

if (o.help || process.argv.length <= 2) {
  process.stdout.write(`mcp-use-probe (--url <http://localhost:3000/mcp> | --stdio "<command>" [--cwd dir]) [--host chatgpt|archestra|stack] [--ua chatgpt|<string>] [--token T] [--calls calls.json] [--timeout ms] [--snapshot out.json] [--submit] [--json]
mcp-use-probe --diff before.json after.json [--json]

Connects over Streamable HTTP (modern stateless protocol first, legacy initialize as fallback), lists tools/resources/templates/prompts,
reads every ui:// resource, optionally calls tools (--calls: [{"tool":"x","arguments":{}}]), and runs the host checklist (data/hosts/<host>.checklist.json).
  --ua chatgpt   also sends an unauthenticated call with a ChatGPT user agent to each protected tool (CG-A01); needs --url
  --token        bearer token for the main connection (never printed; MCP_USE_PROBE_TOKEN also works)
  --submit       also report the submission-only ChatGPT items
Exit: 0 clean · 1 warnings/advisories · 2 errors · 3 usage · 5 network failure
`);
  process.exit(o.help ? 0 : EXIT.USAGE);
}

const emit = (res, text) => { if (json) process.stdout.write(JSON.stringify(envelope(TOOL, res)) + "\n"); else process.stdout.write(text + "\n"); };
const readJson = (path, flag, hint) => {
  requireFile(TOOL, path, flag, json);
  try { return JSON.parse(readFileSync(path, "utf8")); } catch (e) { usage(TOOL, `${flag} ${path}: not valid JSON (${e.message})`, json, hint); }
};

// ---- --diff: two recorded snapshots, no connection ------------------------------------------------
if (o.diff) {
  if (o.url || o.stdio || o.calls || o.snapshot) usage(TOOL, "--diff takes only the two snapshot files", json);
  if (positionals.length !== 2) usage(TOOL, "--diff needs two snapshot files: mcp-use-probe --diff before.json after.json", json);
  const [a, b] = positionals.map((p) => {
    const s = readJson(p, "--diff", "create one with: mcp-use-probe ... --snapshot <file>");
    if (!s || !Array.isArray(s.tools) || !Array.isArray(s.calls)) usage(TOOL, `--diff ${p}: not a probe snapshot (expected "tools" and "calls" arrays)`, json, "create one with: mcp-use-probe ... --snapshot <file>");
    return s;
  });
  const d = diffSnapshots(a, b);
  const noted = d.ignored.length ? "\n" + [...new Set(d.ignored.map((x) => x.note))].map((n) => { const hits = d.ignored.filter((x) => x.note === n); return `note: ${n}${hits[0].field ? ` (${hits.length} schema${hits.length === 1 ? "" : "s"})` : ""}`; }).join("\n") : "";
  emit({ result: d, ok: d.equal }, (d.equal ? "snapshots are equal" : d.differences.map((x) => `${x.change.toUpperCase()} ${x.kind} ${x.id}${x.fields ? ": " + x.fields.map((f) => f.field).join(", ") : ""}`).join("\n")) + noted);
  process.exit(d.equal ? EXIT.OK : EXIT.WARN);
}

// ---- validate everything before any connection or server start --------------------------------------
if (positionals.length) usage(TOOL, `unexpected argument ${positionals[0]}`, json);
if (o.url && o.stdio) usage(TOOL, "give --url or --stdio, not both", json);
if (!o.url && !o.stdio) usage(TOOL, "--url or --stdio is required (or --diff before.json after.json)", json);
if (o.url) { let u; try { u = new URL(o.url); } catch { usage(TOOL, `--url ${o.url}: not a URL`, json); } if (!/^https?:$/.test(u.protocol)) usage(TOOL, `--url ${o.url}: expected an http(s) URL`, json); }
if (o.cwd) { if (!o.stdio) usage(TOOL, "--cwd only applies to --stdio", json); requireDir(TOOL, o.cwd, "--cwd", json); }
if (o.host !== undefined && !HOSTS.includes(o.host)) usage(TOOL, `--host ${o.host}: expected one of ${HOSTS.join(", ")}`, json);
if (o.ua && o.stdio) usage(TOOL, "--ua needs --url (it tests an HTTP connection)", json);
let timeoutMs;
if (o.timeout !== undefined) { timeoutMs = Number(o.timeout); if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) usage(TOOL, `--timeout ${o.timeout}: expected a positive number of milliseconds`, json); }
let calls = [];
if (o.calls) {
  calls = readJson(o.calls, "--calls", 'expected [{"tool":"name","arguments":{}}]');
  if (!Array.isArray(calls) || calls.some((c) => !c || typeof c.tool !== "string")) usage(TOOL, `--calls ${o.calls}: expected [{"tool":"name","arguments":{}}]`, json);
}

const uaString = o.ua === "chatgpt" ? "ChatGPT/1.0" : o.ua;
const token = o.token || process.env.MCP_USE_PROBE_TOKEN;
let client;
try { client = o.stdio ? await connectStdio({ command: o.stdio, cwd: o.cwd, timeoutMs }) : await connect({ url: o.url, token, timeoutMs }); }
catch (e) {
  emit({ ok: false, error: { code: e.code || "connect_failed", message: e.message, suggestion: o.stdio ? "run the command by hand from --cwd and check it starts and reads stdin" : e.code === "unauthorized" ? "pass --token <bearer token>" : "is the server running? try: mcp-use dev --no-open --no-inspector" } }, `connect failed: ${e.message}`);
  process.exit(EXIT.NETWORK);
}

// From here on a server process may be running: always close it, then exit (process.exit inside the try would skip the finally).
let code = EXIT.OK, failure = null;
try {
  const snap = await takeSnapshot(client, { calls });
  const host = o.host;
  let findings = [];
  const notes = [];
  if (host === "chatgpt") {
    findings = chatgptChecks(snap, { submit: !!o.submit });
    if (uaString) {
      // CG-A01 tests an UNAUTHENTICATED call: this connection never carries the token (it could also run authenticated writes).
      let c2 = null;
      try { c2 = await connect({ url: o.url, ua: uaString }); }
      catch (e) { notes.push(`CG-A01 not checked: the server does not accept an unauthenticated connection (${e.message})`); }
      if (c2) {
        try {
          const a = await authChallengeCheck(snap, c2);
          findings.push(...a.findings);
          if (a.note) notes.push(a.note);
          if (a.tested) notes.push(`CG-A01: unauthenticated call with user agent "${uaString}" to ${a.tested.join(", ")} checked`);
        } finally { await c2.close(); }
      }
    }
  } else if (host === "archestra") {
    findings = archestraChecks(snap);
    notes.push("AR-A07 (viewer access), AR-A08 (credential model), AR-A09/A10 (size and theme) and AR-A12 (model context) cannot be probed from outside; see host-archestra/references/unverified.md");
  }
  if (client.state.noise?.length) findings.push({ rule_id: "PROBE", severity: "warning", host: host ?? "stack", method: "probe", target: "stdout", message: `Server wrote ${client.state.noise.length} non-JSON line(s) to stdout, which corrupts the stdio protocol (first: ${JSON.stringify(client.state.noise[0])}). Log to stderr.`, source: "M2" });
  for (const p of snap.problems) findings.push({ rule_id: "PROBE", severity: "warning", host: host ?? "stack", method: "probe", target: "server", message: p, source: "M2" });
  if (o.snapshot) { mkdirSync(dirname(o.snapshot), { recursive: true }); writeFileSync(o.snapshot, JSON.stringify(snap, null, 2)); }
  const counts = { error: findings.filter((x) => x.severity === "error").length, warning: findings.filter((x) => x.severity === "warning").length, advisory: findings.filter((x) => x.severity === "advisory").length };
  const summary = { server: snap.server, tools: snap.tools.length, resources: snap.resources.length, resource_templates: snap.resourceTemplates.length, prompts: snap.prompts.length, ui_resources: snap.ui.length, calls: snap.calls.length, counts, notes, findings, ...(o.snapshot ? { snapshot: o.snapshot } : {}) };
  const text = [`${snap.server.name ?? "?"} ${snap.server.version ?? ""} via ${snap.server.mode} protocol ${snap.server.protocol}: ${summary.tools} tools, ${summary.resources} resources, ${summary.prompts} prompts, ${summary.ui_resources} ui resources`,
    ...findings.map((x) => `${x.severity.toUpperCase().padEnd(8)} ${x.rule_id.padEnd(7)} ${x.target}  ${x.message}  [${x.source}]`), ...notes.map((n) => `note: ${n}`),
    `${counts.error} errors · ${counts.warning} warnings · ${counts.advisory} advisories`].join("\n");
  emit({ result: summary, ok: counts.error === 0 }, text);
  code = counts.error ? EXIT.ERROR : counts.warning || counts.advisory ? EXIT.WARN : EXIT.OK;
} catch (e) {
  failure = e;
} finally {
  await client.close().catch(() => {});
}
if (failure) usage(TOOL, failure?.message ?? String(failure), json, "the server was stopped; re-run, and report a bug if this persists");
process.exit(code);
